<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required on Android 13+ (API 33) to actually display notifications, including the
         foreground-service notification for the running timer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="gis2018.udacity.tametu.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Tametu - get more done, faster"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">
        <!-- targetSdkVersion 34+ requires every foreground service to declare a type. None of
             the built-in categories (mediaPlayback, dataSync, location, ...) fit a Pomodoro
             countdown, so this uses specialUse with a justification, as recommended by
             https://developer.android.com/develop/background-work/services/fgs/service-types -->
        <service
            android:name=".CountDownTimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows an ongoing notification with actions while a Pomodoro work or break countdown is running" />
        </service>

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="false">

        </activity>
        <activity
            android:name=".SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
        <!-- Broadcast receiver for notification action button -->
        <receiver android:name=".StopTimerActionReceiver" />
        <receiver android:name=".StartTimerActionReceiver" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity android:name=".first"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
